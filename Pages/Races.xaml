<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Accordion;assembly=Syncfusion.Maui.Expander"
             x:Class="AdventuresinHetheriaApp.Pages.Races"
             xmlns:models="clr-namespace:AdventuresinHetheriaApp.Models"

             Title="Races">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0d1535" Offset="0.0" />
            <GradientStop Color="#1e2660" Offset="0.5" />
            <GradientStop Color="#0d1535" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>
    <syncfusion:SfAccordion BindableLayout.ItemsSource ="{Binding RaceItems}">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="models:Race">
                <syncfusion:AccordionItem>

                    <syncfusion:AccordionItem.Header
                        <Label Text="{Binding RaceName}" FontAttributes="Bold" Padding="10"/>
                    </syncfusion:AccordionItem.Header>
                    <syncfusion:AccordionItem.Content>
                        <Label Text="{Binding Speed}" Padding="10"/>
                    </syncfusion:AccordionItem.Content>

                </syncfusion:AccordionItem>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </syncfusion:SfAccordion>
</ContentPage>