<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AdventuresinHetheriaApp.Pages.Races"
             xmlns:local="clr-namespace:AdventuresinHetheriaApp.Views"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             Title="Races">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0d1535" Offset="0.0" />
            <GradientStop Color="#1e2660" Offset="0.5" />
            <GradientStop Color="#0d1535" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>
    <ContentPage.BindingContext>
        <local:RacesView />
    </ContentPage.BindingContext>
    <VerticalStackLayout>
        <Border BackgroundColor="#2C3E50" 
                StrokeShape="RoundRectangle 8" 
                Padding="15,10"
                Margin="10">
            <Grid Padding="20">
                <CollectionView x:Name="myCollectionView" ItemsSource="{Binding Races}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Padding="10">
                                <Label Text="{Binding RaceName}" FontSize="18" FontAttributes="Bold"/>
                                <Label Text="{Binding Speed}" FontSize="14" TextColor="Gray"/>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
    </VerticalStackLayout>
</ContentPage>