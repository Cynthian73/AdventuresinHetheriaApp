<!-- MainPage.xaml -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AdventuresinHetheriaApp.MainPage"
             xmlns:page="clr-namespace:AdventuresinHetheriaApp.Pages"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0d1535" Offset="0.0" />
            <GradientStop Color="#1e2660" Offset="0.5" />
            <GradientStop Color="#0d1535" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>
    <VerticalStackLayout>
        <Grid RowDefinitions="*, *, *,40,40,40,40,40, 40, 40, 40, 40" ColumnDefinitions="*" HorizontalOptions="Center" Padding="5">
            <Image Grid.Row="0" 
                   Background="Transparent" 
                   Source="ainhpng.png" 
                   HorizontalOptions="Center" 
                   Aspect="Fill"/>
            <Label Grid.Row="1" 
                   FontFamily="Impact" 
                   FontSize="25" 
                   TextColor="#8a9bc4" 
                   Text="Character Creation" 
                   HorizontalOptions="Center"/>
            <Image Grid.Row="2" 
                   Source="golddividingornament.png"/>
            <buttons:SfButton Grid.Row="3" 
                              Background="#0d1535"
                              Stroke="#8a9bc4"
                              StrokeThickness="1"
                              x:Name="btnCharacters" 
                              WidthRequest="300"
                              HeightRequest="40"
                              Clicked="OnCharactersButtonClicked" >
                <buttons:SfButton.Content>
                    <DataTemplate>
                            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="5">
                                <Image Source="user.png" VerticalOptions="Center" HeightRequest="30" WidthRequest="30"/>
                                <Label Text="Characters" FontFamily="Impact" FontSize="25" VerticalOptions="Center" TextColor="White"/>
                            </HorizontalStackLayout>
                        </DataTemplate>
                </buttons:SfButton.Content>
            </buttons:SfButton>
            <buttons:SfButton Grid.Row="4" 
                  Background="#0d1535"
                  Stroke="#8a9bc4"
                  StrokeThickness="1"
                  x:Name="btnRaces" 
                  WidthRequest="300"
                  HeightRequest="40"
                  Clicked="OnRacesButtonClicked">
                <buttons:SfButton.Content>
                    <DataTemplate>
                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="5">
                            <Image Source="star.png" HeightRequest="30" VerticalOptions="Center" WidthRequest="30"/>
                            <Label Text="Races" FontFamily="Impact" FontSize="25" VerticalOptions="Center" TextColor="White"/>
                        </HorizontalStackLayout>
                    </DataTemplate>
                </buttons:SfButton.Content>
            </buttons:SfButton>
            <buttons:SfButton Grid.Row="5" 
                  Background="#0d1535"
                  Stroke="#8a9bc4"
                  StrokeThickness="1"
                  x:Name="btnClasses" 
                  WidthRequest="300"
                  HeightRequest="40">
                <buttons:SfButton.Content>
                    <DataTemplate>
                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="5">
                            <Image Source="whitebook.png" HeightRequest="30" VerticalOptions="Center" WidthRequest="30"/>
                            <Label Text="Classes" FontFamily="Impact" FontSize="25" VerticalOptions="Center" TextColor="White"/>
                        </HorizontalStackLayout>
                    </DataTemplate>
                </buttons:SfButton.Content>
            </buttons:SfButton>
            <buttons:SfButton Grid.Row="6" 
                              Background="#0d1535"
                              Stroke="#8a9bc4"
                              StrokeThickness="1"
                              x:Name="btnBackgrounds" 
                              WidthRequest="300"
                              HeightRequest="40">
                <buttons:SfButton.Content>
                    <DataTemplate>
                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="5">
                            <Image Source="clipboard.png" VerticalOptions="Center" HeightRequest="30" WidthRequest="30"/>
                            <Label Text="Backgrounds" FontFamily="Impact" FontSize="25" VerticalOptions="Center" TextColor="White"/>
                        </HorizontalStackLayout>
                    </DataTemplate>
                </buttons:SfButton.Content>
            </buttons:SfButton>
            <buttons:SfButton Grid.Row="7" 
                              Background="#0d1535"
                              Stroke="#8a9bc4"
                              StrokeThickness="1"
                              x:Name="btnSkills" 
                              WidthRequest="300"
                              HeightRequest="40">
                <buttons:SfButton.Content>
                    <DataTemplate>
                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="5">
                            <Image Source="trophy.png" VerticalOptions="Center" HeightRequest="30" WidthRequest="30"/>
                            <Label Text="Skills" FontFamily="Impact" FontSize="25" VerticalOptions="Center" TextColor="White"/>
                        </HorizontalStackLayout>
                    </DataTemplate>
                </buttons:SfButton.Content>
            </buttons:SfButton>
            <buttons:SfButton Grid.Row="8" 
                              Background="#0d1535"
                              Stroke="#8a9bc4"
                              StrokeThickness="1"
                              x:Name="btnSpells" 
                              WidthRequest="300"
                              HeightRequest="40">
                <buttons:SfButton.Content>
                    <DataTemplate>
                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="5">
                            <Image Source="wand.png" VerticalOptions="Center" HeightRequest="30" WidthRequest="30"/>
                            <Label Text="Spells" FontFamily="Impact" FontSize="25" VerticalOptions="Center" TextColor="White"/>
                        </HorizontalStackLayout>
                    </DataTemplate>
                </buttons:SfButton.Content>
            </buttons:SfButton>
            <buttons:SfButton Grid.Row="9" 
                              Background="#0d1535"
                              Stroke="#8a9bc4"
                              StrokeThickness="1"
                              x:Name="btnMythic" 
                              WidthRequest="300"
                              HeightRequest="40">
                <buttons:SfButton.Content>
                    <DataTemplate>
                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="5">
                            <Image Source="flame.png" VerticalOptions="Center" HeightRequest="30" WidthRequest="30"/>
                            <Label Text="Mythic" FontFamily="Impact" FontSize="25" VerticalOptions="Center" TextColor="White"/>
                        </HorizontalStackLayout>
                    </DataTemplate>
                </buttons:SfButton.Content>
            </buttons:SfButton>
            <buttons:SfButton Grid.Row="10" 
                              Background="#0d1535"
                              Stroke="#8a9bc4"
                              StrokeThickness="1"
                              x:Name="btnExpanded" 
                              WidthRequest="300"
                              HeightRequest="40">
                <buttons:SfButton.Content>
                    <DataTemplate>
                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="5">
                            <Image Source="star2.png" VerticalOptions="Center" HeightRequest="30" WidthRequest="30"/>
                            <Label Text="Expanded" FontFamily="Impact" FontSize="25" VerticalOptions="Center" TextColor="White"/>
                        </HorizontalStackLayout>
                    </DataTemplate>
                </buttons:SfButton.Content>
            </buttons:SfButton>
            <Label Grid.Row="11" HorizontalOptions="Center" FontSize="18" TextColor="#8a9bc4" x:Name="lblVersion"/>
        </Grid>

    </VerticalStackLayout>
</ContentPage>
