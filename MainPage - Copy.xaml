<!-- MainPage.xaml -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AdventuresinHytheriaApp.MainPage2"
             xmlns:control="clr-namespace:AdventuresinHytheriaApp.Control"
             xmlns:page="clr-namespace:AdventuresinHytheriaApp.Views"
             xmlns:tabView="clr-namespace:Syncfusion.Maui.TabView;assembly=Syncfusion.Maui.TabView"
             xmlns:editors="clr-namespace:Syncfusion.Maui.Core.Themes;assembly=Syncfusion.Maui.Inputs">
    <VerticalStackLayout BackgroundColor="#F5F7FA">
        <Grid ColumnDefinitions="100, 400, *" RowDefinitions="*,*" Padding="5">
            <Image Source="ainhpng.png" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"/>
            <!-- Header Text above the TabView -->
           <Label Text="Adventures in Hetheria" 
               FontSize="35" 
               Grid.Column="1" Grid.Row="0"
               TextColor="#1E293B"
               FontAttributes="Bold" 
               HorizontalOptions="Start" 
               VerticalOptions="Center"/>
           
           <!-- Header Text above the TabView -->
          <Label Text="Character Creator" 
               FontSize="25" 
               Grid.Column="1" Grid.Row="1"
               TextColor="#1E293B"
               HorizontalOptions="Start" VerticalOptions="Start"/>
           <Button Text="New Character"
               Grid.Column="3"
               HorizontalOptions="Fill"
               ImageSource="add.png"
               BackgroundColor="#1E293B"
               FontSize="25"
               TextColor="White"
               CornerRadius="5" />
        </Grid>
        <tabView:SfTabView x:Name="tabView" TabBarBackground="#F5F7FA" IndicatorBackground="#008CA8" IndicatorPlacement="Fill">
            <tabView:SfTabView.Items>
                <control:CustomTabItem Header="Characters" FontSize="32" TextColor="#F5F7FA">
                    <control:CustomTabItem.Page>
                        <page:Characters/>
                    </control:CustomTabItem.Page>
                </control:CustomTabItem>
                <control:CustomTabItem Header="Races" FontSize="32" TextColor="#F5F7FA">
                    <control:CustomTabItem.Page>
                        <page:Races/>
                    </control:CustomTabItem.Page>
                </control:CustomTabItem>

            </tabView:SfTabView.Items>
        </tabView:SfTabView>
    </VerticalStackLayout>
</ContentPage>
